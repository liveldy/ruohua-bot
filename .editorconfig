root = true

# 全项目统一：UTF-8 无 BOM + LF。任何编辑器打开都按这套走。
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Windows 批处理：cmd 按控制台代码页读文件，必须是 CRLF；内容保持纯 ASCII。
[*.{bat,cmd}]
end_of_line = crlf

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.jsonl]
insert_final_newline = false
