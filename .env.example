# 复制为 .env 后填写。.env 已被 git 忽略。
# 模型接口（OpenAI 兼容）
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_API_KEY=
MODEL_NAME=deepseek-chat
# 看图用的模型；留空就用上面的 MODEL_NAME
MODEL_VISION_NAME=

# OneBot / NapCat 连接（也可直接改 config/bot.json）
ONEBOT_MODE=forward
ONEBOT_WS_URL=ws://127.0.0.1:3001
ONEBOT_ACCESS_TOKEN=
ONEBOT_REVERSE_PORT=3002
ONEBOT_HTTP_URL=http://127.0.0.1:3000

# 管理员 QQ 号，逗号分隔
ADMIN_QQ=

# Python 侧车（截图 / 语音识别 / 向量化）
SIDECAR_ENABLED=true
SIDECAR_URL=http://127.0.0.1:8765
SIDECAR_AUTOSTART=true
SIDECAR_PYTHON=python

# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# 控制面板（配置 / 监视终端 / 实时调试），也可直接改 config/web.json
WEB_ENABLED=true
WEB_HOST=127.0.0.1
WEB_PORT=8787
WEB_TOKEN=
WEB_ALLOW_REMOTE=false

# 沙箱边界：sandbox（默认，限制路径与命令）| trusted（完全信任）
BOUNDARY_MODE=sandbox
